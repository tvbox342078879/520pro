#!/usr/bin/env bash
# 520pro · 提交闸（H5，v0.8.20 工程H）
# ------------------------------------------------------------------
# 装法：bash install.sh 自动装到 <仓库根>/.git/hooks/pre-commit
# 绕过：git commit --no-verify（能绕，但必须写明理由；真正的终局闸在 CI）
# 判据不在这里重写：直接调 secret_scan.py 与 verify.sh --repo-only，
# 避免"两套判据各自演化"（M1 单一真源）。
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 1
LOG="${TMPDIR:-/tmp}/_520_precommit.log"
: >"$LOG"

echo "[pre-commit] ① 密钥/卫生扫描（strict）"
if ! python3 secret_scan.py --strict >>"$LOG" 2>&1; then
  echo "✗ 提交被拒：密钥/卫生扫描未通过"
  grep -E '✗|->' "$LOG" | head -6 | sed 's/^/   /'
  echo "   完整日志：$LOG"
  echo "   处置：删掉明文密钥/个人路径后重新 add（确属误报再改判据）"
  exit 1
fi

echo "[pre-commit] ② 手机指令云端副本同步"
# 只在「手机指令.md 进本次提交」时跑：其它改动不该被网络请求拖慢。
# ★ 必须加 -c core.quotepath=false：git 默认把非 ASCII 文件名转义成 "\346\211\213\346..."，
#   直接 grep '手机指令.md' 永远匹配不上——首版就是这样静默跳过的（还说"未改该文件"），
#   自动同步形同虚设。这类"看起来在工作"的判据必须有正样本证明它会命中。
if git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR | grep -qx '手机指令.md'; then
  sout="$(python3 sync_phone_directive.py --repo "$ROOT" 2>&1)"
  src=$?
  printf '%s\n' "$sout" >>"$LOG"
  if [ "$src" -eq 0 ]; then
    git add docs/手机指令云端副本.json 2>/dev/null || true
    # 如实转述脚本结论：NOOP（内容没变）与 SYNCED（真写了）是两回事，不合并成"已同步"
    echo "  ✓ $(printf '%s' "$sout" | tail -1)"
  else
    echo "  ⚠ 同步未成功（rc=$src）；判据会因此变红并拒提交"
    printf '%s\n' "$sout" | tail -3 | sed 's/^/   /'
  fi
else
  echo "  · 本次提交未改 手机指令.md，跳过"
fi

echo "[pre-commit] ③ 真源联动提醒（G6 轻量版·v0.8.28，advisory 不阻断）"
# ★ 脚本内部同样用 -c core.quotepath=false 取暂存清单（中文名转义教训，见②）。
#   真源清单唯一来源是 docs/registry.md 第 2 列；它列出"谁在读"，M5 连带核对靠人。
python3 verify/linkage_notice.py --repo "$ROOT" >>"$LOG" 2>&1 || true
# 跳过/命中/异常三种情况都出声（②的静默失效教训：看不见的闸等于没装）
grep -E '⚑|· 本次提交未动真源|⚠ linkage' "$LOG" | sed 's/^/   /'
grep -q '⚑' "$LOG" && echo "  （↑ 改了真源：引用方清单见上，语义是否过期机检查不了）"

echo "[pre-commit] ④ 仓库级自检（--repo-only：不依赖安装副本）"
if ! bash verify.sh --repo-only --target "$ROOT" >>"$LOG" 2>&1; then
  echo "✗ 提交被拒：仓库级自检未通过"
  grep -E '  ✗' "$LOG" | head -8 | sed 's/^/   /'
  echo "   完整日志：$LOG"
  echo "   处置：逐条修红项；不许 --no-verify 硬提交（那等于把闸拆了）"
  exit 1
fi

echo "✓ pre-commit 通过（密钥干净 + 仓库自洽）"
exit 0
