#!/usr/bin/env bash
# 520pro · 提交闸（H5，v0.8.20 工程H）
# ------------------------------------------------------------------
# 装法：bash install.sh 自动装到 <仓库根>/.git/hooks/pre-commit
# 绕过：git commit --no-verify（能绕，但必须写明理由；真正的终局闸在 CI）
# 判据不在这里重写：直接调 secret_scan.py 与 verify.sh --repo-only，
# 避免"两套判据各自演化"（M1 单一真源）。
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 1
LOG="${TMPDIR:-/tmp}/_520_precommit.log"
: >"$LOG"

echo "[pre-commit] ① 密钥/卫生扫描（strict）"
if ! python3 secret_scan.py --strict >>"$LOG" 2>&1; then
  echo "✗ 提交被拒：密钥/卫生扫描未通过"
  grep -E '✗|->' "$LOG" | head -6 | sed 's/^/   /'
  echo "   完整日志：$LOG"
  echo "   处置：删掉明文密钥/个人路径后重新 add（确属误报再改判据）"
  exit 1
fi

echo "[pre-commit] ② 手机指令云端副本同步"
# 只在「手机指令.md 进本次提交」时跑：其它改动不该被网络请求拖慢。
# 同步失败不在这里硬拦（网络/库环境可能真不可用），但下面的 verify.sh 会因判据红而拒提交，
# 也就是"改了粘贴区就必須同步成功"这条约束仍然成立，只是失败原因由判据统一报。
if git diff --cached --name-only --diff-filter=ACMR | grep -qx '手机指令.md'; then
  if python3 sync_phone_directive.py --repo "$ROOT" >>"$LOG" 2>&1; then
    git add docs/手机指令云端副本.json 2>/dev/null || true
    echo "  ✓ 粘贴区有变更，已同步云端副本（回读通过）"
  else
    echo "  ⚠ 同步未成功（网络或资料库环境不可用）；判据会因此变红并拒提交"
    tail -3 "$LOG" | sed 's/^/   /'
  fi
else
  echo "  · 本次提交未改 手机指令.md，跳过"
fi

echo "[pre-commit] ③ 仓库级自检（--repo-only：不依赖安装副本）"
if ! bash verify.sh --repo-only --target "$ROOT" >>"$LOG" 2>&1; then
  echo "✗ 提交被拒：仓库级自检未通过"
  grep -E '  ✗' "$LOG" | head -8 | sed 's/^/   /'
  echo "   完整日志：$LOG"
  echo "   处置：逐条修红项；不许 --no-verify 硬提交（那等于把闸拆了）"
  exit 1
fi

echo "✓ pre-commit 通过（密钥干净 + 仓库自洽）"
exit 0
